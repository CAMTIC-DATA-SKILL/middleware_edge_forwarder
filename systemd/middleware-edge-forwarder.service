# /opt 고정 설치 예시. 현재 체크아웃 경로로 등록하려면 service_add.sh 를 사용한다.
[Unit]
Description=Edge Forwarder (collector ZeroMQ -> northbound OPC UA)
After=network-online.target collector-plc.service
Wants=network-online.target

[Service]
Type=simple
User=collector
Group=collector

WorkingDirectory=/opt/middleware_edge_forwarder
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/middleware_edge_forwarder/.env
ExecStart=/opt/middleware_edge_forwarder/.venv/bin/python /opt/middleware_edge_forwarder/main.py

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=middleware-edge-forwarder

[Install]
WantedBy=multi-user.target
