# 북향 태그 매핑 JSON (프로젝트 루트 기준 상대경로 또는 절대경로). 없으면 auto 노드만 사용
TAG_MAP_FILE=tag_map.json

RECONNECT_PERIOD_MS=5000
# 이 시간 동안 DATA 가 없으면 해당 수집원 태그를 UncertainLastUsableValue 로 표시 (0 = 끔)
SOURCE_STALE_MS=10000

# ZeroMQ SUB (collector PUB 에 connect, DATA/HEALTH 만 사용)
# collector-plc 의 ZMQ_PUB_ENDPOINT 와 맞춘다. collector 가 여럿이면 쉼표로 나열
ZMQ_SUB_ENDPOINTS=tcp://127.0.0.1:5556
ZMQ_SUB_BIND=false
ZMQ_LINGER_MS=0
# 토픽: {ZMQ_TOPIC_ROOT}.{kind}.{device_key}.{msg_type}
ZMQ_TOPIC_ROOT=collector
# 구독할 collector 종류 (쉼표). 비우면 collector.* 전체
ZMQ_COLLECTOR_KINDS=plc
# 특정 device_key 만 받을 때 (쉼표). 비우면 전체
ZMQ_DEVICE_KEYS=

# 북향 OPC UA 서버
OPCUA_ENDPOINT=opc.tcp://0.0.0.0:4840/edge/
OPCUA_SERVER_NAME=middleware_edge_forwarder
OPCUA_APPLICATION_URI=urn:middleware:edge:forwarder
# 상위 시스템은 이 URI 로 네임스페이스 번호를 찾는다
OPCUA_NAMESPACE_URI=urn:middleware:edge:forwarder:tags
# tag map 에 없는 샘플도 {OPCUA_AUTO_ROOT}/{kind}/{device_key}/{addr} 로 노출
OPCUA_AUTO_CREATE_NODES=true
OPCUA_AUTO_ROOT=Collectors

# 로깅: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
